@model MagicVilla_WebPage.Models.Dto.VillaNumberCreateDTO
@using Microsoft.AspNetCore.Mvc.Rendering

<form asp-action="CreateVillaNumber" asp-controller="VillaNumber">
    <br />
    <div class="container border p-3">
        <h1 class="text-primary">Create VillaNumber</h1>
        <hr />
        <div class="row">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="col-2">
                <label asp-for="VillaNo" class="control-label" style="font-size:20px;"></label>
            </div>
            <div class="col-10 pb-3">
                <input asp-for="VillaNo" class="form-control" />
                <span asp-validation-for="VillaNo" class="text-danger"></span>
            </div>
            <div class="col-2">
                <label asp-for="SpecialsDetails" class="control-label" style="font-size:20px;"></label>
            </div>
            <div class="col-10 pb-3">
                <input asp-for="SpecialsDetails" class="form-control" />
                <span asp-validation-for="SpecialsDetails" class="text-danger"></span>
            </div>
            <div class="col-2">
                <label asp-for="VillaID" class="control-label" style="font-size:20px;"></label>
            </div>
            <div class="col-10 pb-3">
                @Html.DropDownListFor(model => model.VillaID, new SelectList(ViewBag.Villas, "Value", "Text"), "Select Villa", new { @class = "form-control" })
                <span asp-validation-for="VillaID" class="text-danger"></span>
            </div>
            <div class="col-5 offset-2">
                <a asp-action="VillaNumberIndex" asp-controller="VillaNumber" class="btn-primary btn form-control">Back to list</a>
            </div>
            <div class="col-5">
                <input type="submit" value="Create" class="btn-success form-control" />
            </div>
        </div>
    </div>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
