@model MagicVilla_WebPage.Models.Dto.VillaNumberDTO
<form asp-action="DeleteVillaNumber">
    <br />
    <div class="container border p-3">
        <h1 class="text-primary">Delete Villa Number</h1>
        <hr />
        <input hidden asp-for="VillaNo" />
        <div class="row">

            <div class="col-2">
                <label asp-for="VillaNo" class="control-label" style="font-size:20px;"></label>
            </div>
            <div class="col-10 pb-3">
                <input asp-for="VillaNo" class="form-control" disabled />
            </div>
            <div class="col-2">
                <label asp-for="SpecialsDetails" class="control-label" style="font-size:20px;"></label>
            </div>
            <div class="col-10 pb-3">
                <input asp-for="SpecialsDetails" class="form-control" disabled />
            </div>
            <div class="col-2">
                <label asp-for="VillaID" class="control-label" style="font-size:20px;"></label>
            </div>
            <div class="col-10 pb-3">
                <textarea asp-for="VillaID" class="form-control" rows="5" disabled></textarea>
            </div>
            <div class="col-5 offset-2">
                <a asp-action="VillaNumberIndex" asp-controller="VillaNumber" class="btn-primary btn form-control">Back to list</a>
            </div>
            <div class="col-5">
                <input type="submit" value="Delete" class="btn-success form-control" />
            </div>


        </div>

    </div>

</form>
