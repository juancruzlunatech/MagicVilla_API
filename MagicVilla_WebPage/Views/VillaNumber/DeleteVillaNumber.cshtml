@model MagicVilla_WebPage.Models.VM.VillaNumberDeleteVM
@using Microsoft.AspNetCore.Mvc.Rendering

<form asp-action="DeleteVillaNumber" asp-controller="VillaNumber">
    <br />
    <div class="container border p-3">
        <h1 class="text-primary">Delete VillaNumber</h1>
        <hr />


        <div class="row">
            <input hidden asp-for="VillaNumber.VillaNo"/>
            <div class="col-2">
                <label asp-for="VillaNumber.VillaNo" class="control-label" style="font-size:20px;"></label>
            </div>
            <div class="col-10 pb-3">
                <input asp-for="VillaNumber.VillaNo" disabled class="form-control" />
      
            </div>
            <div class="col-2">
                <label asp-for="VillaNumber.VillaID" class="control-label" style="font-size:20px;"></label>
            </div>
            <div class="col-10 pb-3">
                <select asp-for="VillaNumber.VillaID" disabled class="form-select" asp-items="@Model.VillaList">
                    <option disabled selected>--Select Villa</option>
                </select>
    
            </div>

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="col-2">
                <label asp-for="VillaNumber.SpecialsDetails" class="control-label" style="font-size:20px;"></label>
            </div>
            <div class="col-10 pb-3">
                <textarea asp-for="VillaNumber.SpecialsDetails" disabled class="form-control"></textarea>
           
            </div>

            <div class="col-5 offset-2">
                <a asp-action="VillaNumberIndex" asp-controller="VillaNumber" class="btn-primary btn form-control">Back to list</a>
            </div>
            <div class="col-5">
                <input type="submit" value="Delete" class="btn-success form-control" />
            </div>
        </div>
    </div>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
