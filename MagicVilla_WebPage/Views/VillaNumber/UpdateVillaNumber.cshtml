@model MagicVilla_WebPage.Models.VM.VillaNumberUpdateVM
@using Microsoft.AspNetCore.Mvc.Rendering

<form asp-action="UpdateVillaNumber" asp-controller="VillaNumber">
    <br />
    <div class="container border p-3">
        <h1 class="text-primary">Update VillaNumber</h1>
        <hr />

        <input hidden asp-for="VillaNumber.VillaNo" />
        <div class="row">
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="col-2">
                <label asp-for="VillaNumber.VillaNo" class="control-label" style="font-size:20px;"></label>
            </div>
            <div class="col-10 pb-3">
                <input asp-for="VillaNumber.VillaNo" disabled class="form-control" />
                <span asp-validation-for="VillaNumber.VillaNo" class="text-danger"></span>
            </div>
            <div class="col-2">
                <label asp-for="VillaNumber.VillaID" class="control-label" style="font-size:20px;"></label>
            </div>
            <div class="col-10 pb-3">
                <select asp-for="VillaNumber.VillaID" class="form-select" asp-items="@Model.VillaList">
                    <option disabled selected>--Select Villa</option>
                </select>
                <span asp-validation-for="VillaNumber.VillaID" class="text-danger"></span>
            </div>

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="col-2">
                <label asp-for="VillaNumber.SpecialsDetails" class="control-label" style="font-size:20px;"></label>
            </div>
            <div class="col-10 pb-3">
                <textarea asp-for="VillaNumber.SpecialsDetails" class="form-control"></textarea>
                <span asp-validation-for="VillaNumber.SpecialsDetails" class="text-danger"></span>
            </div>

            <div class="col-5 offset-2">
                <a asp-action="VillaNumberIndex" asp-controller="VillaNumber" class="btn-primary btn form-control">Back to list</a>
            </div>
            <div class="col-5">
                <input type="submit" value="Update" class="btn-success form-control" />
            </div>
        </div>
    </div>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
