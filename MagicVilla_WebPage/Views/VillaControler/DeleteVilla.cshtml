@model MagicVilla_WebPage.Models.Dto.VillaDTO
<form asp-action="DeleteVilla">
    <br />
    <div class="container border p-3">
        <h1 class="text-primary">Delete Villa</h1>
        <hr />
        <input hidden asp-for="Id" />
        <div class="row">
            <div class="col-2">
                <label asp-for="Name" class="control-label" style="font-size:20px;"></label>
            </div>
            <div class="col-10 pb-3">
                <input asp-for="Name" class="form-control" disabled />
            </div>
            <div class="col-2">
                <label asp-for="Rate" class="control-label" style="font-size:20px;"></label>
            </div>
            <div class="col-10 pb-3">
                <input asp-for="Rate" class="form-control" disabled />
            </div>
            <div class="col-2">
                <label asp-for="Details" class="control-label" style="font-size:20px;"></label>
            </div>
            <div class="col-10 pb-3">
                <textarea asp-for="Details" class="form-control" rows="5" disabled></textarea>
            </div>
            <div class="col-2">
                <label asp-for="ImageUrl" class="control-label" style="font-size:20px;"></label>
            </div>
            <div class="col-10 pb-3">
                <input asp-for="ImageUrl" class="form-control" disabled />
            </div>
            <div class="col-2">
                <label asp-for="Ocuppancy" class="control-label" style="font-size:20px;"></label>
            </div>
            <div class="col-10 pb-3">
                <input asp-for="Ocuppancy" class="form-control" disabled />
            </div>
            <div class="col-2">
                <label asp-for="Sqft" class="control-label" style="font-size:20px;"></label>
            </div>
            <div class="col-10 pb-3">
                <input asp-for="Sqft" class="form-control" disabled />
            </div>
            <div class="col-2">
                <label asp-for="Amenity" class="control-label" style="font-size:20px;"></label>
            </div>
            <div class="col-10 pb-3">
                <textarea asp-for="Amenity" class="form-control" rows="5" disabled></textarea>
            </div>
            <div class="col-5 offset-2">
                <a asp-action="VillaIndex" asp-controller="VillaControler" class="btn-primary btn form-control">Back to list</a>
            </div>
            <div class="col-5">
                <input type="submit" value="Delete" class="btn-success form-control" />
            </div>
        </div>
    </div>
</form>
