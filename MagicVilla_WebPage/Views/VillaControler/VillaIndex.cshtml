@model IEnumerable<MagicVilla_WebPage.Models.Dto.VillaDTO>
<br/>
<div class="container p-4 border">
    <div class="row pb-2">
        <div class="col">
            <h1 class="text-primary">Villa List</h1>
        </div>
        <div class="col text-end pt-1">
            <a asp-controller="VillaControler" asp-action="CreateVilla" class="btn btn-outline-primary"><i class="bi bi-plus-square"></i>Create New Villa</a>
    </div>
    <table class="table">
        <thead>
            <tr>
                <th>
                    Name
                </th>
                <th>
                    Ocupancy
                </th>
                <th>
                    Rate
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach(var item in Model){
            <tr>
                        <td>@item.Name</td>
                        <td>@item.Ocuppancy</td>
                        <td>@((item.Rate).ToString("c"))</td>
                        <td>
                            <a asp-controller="VillaControler" asp-action="UpdateVilla" asp-route-villaId="@item.Id" class="btn btn-success"><i class="bi bi-pencil-square"></i></a>
                            <a asp-controller="VillaControler" asp-action="DeleteVilla" asp-route-villaId="@item.Id" class="btn btn-danger"><i class="bi bi-trash3"></i></a>
                        </td>
                    
            </tr>
                }
        </tbody>
    </table>
</div>